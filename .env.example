NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/bahayhub
JWT_ACCESS_SECRET=replace-with-at-least-32-character-random-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-random-refresh-secret
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
DATABASE_URL_TEST=postgres://postgres:YOUR_PASSWORD@localhost:5432/bahayhub_test
COOKIE_SAME_SITE=lax
# Number of reverse proxy hops to trust (set to 1 on Render)
TRUST_PROXY_HOPS=0
